{
  "expo": {
    "name": "Nexora",
    "slug": "nexora-customer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nexoracustomerapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.nexora.customer"
    },
    "android": {
      "package": "com.nexora.customer",
      "adaptiveIcon": {
        "backgroundColor": "#041427",
        "foregroundImage": "./assets/images/icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "backgroundColor": "#041427",
      "translucent": false,
      "barStyle": "light-content"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#041427",
          "image": "./assets/images/nexora-logo.png",
          "imageWidth": 136
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

